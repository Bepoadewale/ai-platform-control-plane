# Rendered locally by pilot-cloud-bootstrap-runtime.sh; deliberately excluded from
# platform/kustomization.yaml because this account-specific IRSA role ARN is not desired
# state for every environment.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: pilot-secrets-reader
  namespace: platform-system
  annotations:
    eks.amazonaws.com/role-arn: "${EXTERNAL_SECRETS_ROLE_ARN}"
